  <preface xml:id="math-111">
    <title>Math 111</title>




    <p>
      This 24-exercise sequence reviews the skills that matter most at the start of
      calculus. Work from top to bottom for a broad readiness check, or jump to a
      topic that needs attention. Use <q>Randomize</q> after checking a response to
      practice the same idea with new values.
    </p>

    <p><em>Algebra and equations</em></p>

    <exercise xml:id="math111-rational-arithmetic">
      <title>Rational-number arithmetic</title>
      <webwork source="Library/Utah/Intermediate_Algebra/set14_Review/s14p1.pg"/>
    </exercise>
    <exercise xml:id="math111-linear-graph">
      <title>Read and describe a linear graph</title>
      <webwork source="Contrib/CUNY/CityTech/CollegeAlgebra_Trig/setLinesReview/from-graph-ratl-inter.pg"/>
    </exercise>
    <exercise xml:id="math111-linear-system">
      <title>Solve a system of equations</title>
      <webwork source="Contrib/CCCS/AlgebraicLiteracy/IA_4.1/OpenStax_IA_4.1_30.pg"/>
    </exercise>
    <exercise xml:id="math111-factoring">
      <title>Factor a quadratic polynomial</title>
      <webwork source="Contrib/CCCS/CollegeAlgebra/Prerequisite_Review/CCD_CCCS_Openstax_AlgTrig_AT-1-001-AS_1_5_F.pg"/>
    </exercise>

    <p><em>Inequalities and domains</em></p>

    <exercise xml:id="math111-interval-notation">
      <title>Write a domain restriction in interval notation</title>
      <webwork source="Contrib/Mizzou/Algebra/real_numbers_interval_notation/conv_to_int_set_01.pg"/>
    </exercise>
    <exercise xml:id="math111-absolute-inequality">
      <title>Solve an absolute-value inequality</title>
      <webwork source="Contrib/Mizzou/College_Algebra/Inequalities_Absolute_Value/Ineq4.pg"/>
    </exercise>
    <exercise xml:id="math111-polynomial-inequality">
      <title>Solve a factored polynomial inequality</title>
      <webwork source="Contrib/Mizzou/College_Algebra/Inequalities_Polynomial/Factored.pg"/>
    </exercise>

    <p><em>Functions and graphs</em></p>

    <exercise xml:id="math111-function-notation">
      <title>Evaluate expressions in function notation</title>
      <webwork source="Contrib/CCCS/CollegeAlgebra/3.1/RRCC_CCCS_Openstax_AlgTrig_AT-1-001-AS_3_1_27.pg"/>
    </exercise>
    <exercise xml:id="math111-piecewise">
      <title>Evaluate and interpret a piecewise function</title>
      <webwork source="Library/LoyolaChicago/Precalc/Chap2Sec2/Connally3-2-Piecewise-function-ineq.pg"/>
    </exercise>
    <exercise xml:id="math111-transformations">
      <title>Recognize graph transformations</title>
      <webwork source="Library/ASU-topics/setTransformationFunctions/jj1.pg"/>
    </exercise>
    <exercise xml:id="math111-composition">
      <title>Compose functions</title>
      <webwork source="Contrib/CCCS/CollegeAlgebra/3.4/RRCC_CCCS_Openstax_AlgTrig_AT-1-001-AS_3_4_11.pg"/>
    </exercise>
    <exercise xml:id="math111-inverse">
      <title>Restrict a domain and find an inverse</title>
      <webwork source="Contrib/CCCS/PreCalculus/3.7/CCD_CCCS_Openstax_AlgTrig_AT-1-001-AS_3_7_14.pg"/>
    </exercise>
    <exercise xml:id="math111-difference-quotient">
      <title>Simplify a difference quotient</title>
      <webwork source="Library/Wiley/setAnton_Section_0.2/Question52.pg"/>
    </exercise>

    <p><em>Polynomial and rational functions</em></p>

    <exercise xml:id="math111-polynomial-sign">
      <title>Connect polynomial roots with its graph</title>
      <webwork source="Library/Rochester/setAlgebra23PolynomialZeros/describe_graph.pg"/>
    </exercise>
    <exercise xml:id="math111-rational-asymptotes">
      <title>Find a rational function's domain and asymptotes</title>
      <webwork source="Contrib/CCCS/CollegeAlgebra/5.6/RRCC_CCCS_Openstax_AlgTrig_AT-1-001-AS_5_6_13.pg"/>
    </exercise>

    <p><em>Exponents and logarithms</em></p>

    <exercise xml:id="math111-integer-exponents">
      <title>Simplify integer exponents</title>
      <webwork source="Contrib/CUNY/CityTech/CollegeAlgebra_Trig/IntegerExponents/divide-medium.pg"/>
    </exercise>
    <exercise xml:id="math111-rational-exponents">
      <title>Simplify rational exponents</title>
      <webwork source="Contrib/CUNY/CityTech/CollegeAlgebra_Trig/RationalExponents/combine-rational-exponents-multiply.pg"/>
    </exercise>
    <exercise xml:id="math111-exponential-model">
      <title>Recover an exponential function from values</title>
      <webwork source="Contrib/Piedmont/OnlineMATH1113/Test3/3.pg"/>
    </exercise>
    <exercise xml:id="math111-log-equation">
      <title>Solve a logarithmic equation exactly</title>
      <webwork source="Library/Wiley/setAnton_Section_0.5/Question23.pg"/>
    </exercise>

    <p><em>Trigonometry</em></p>

    <exercise xml:id="math111-radians">
      <title>Convert degree measures to radians</title>
      <webwork source="Contrib/METU-NCC/MAT100/23a_Degree-radian.pg"/>
    </exercise>
    <exercise xml:id="math111-sinusoid">
      <title>Read a sinusoidal function and its graph</title>
      <webwork source="Contrib/CUNY/CityTech/CollegeAlgebra_Trig/GraphingSineCosine/function-graphing.pg"/>
    </exercise>
    <exercise xml:id="math111-unit-circle">
      <title>Evaluate trigonometric functions exactly</title>
      <webwork source="Library/LoyolaChicago/Precalc/Chap6Sec6/Q08-old.pg"/>
    </exercise>
    <exercise xml:id="math111-inverse-trig">
      <title>Find the domain and range of an inverse-trig function</title>
      <webwork source="Library/UCSB/Stewart5_1_6/Stewart5_1_6_75.pg"/>
    </exercise>
    <exercise xml:id="math111-trig-identity">
      <title>Simplify using a trigonometric identity</title>
      <webwork source="Library/Rochester/setTrig07Identity/p5.pg"/>
    </exercise>
  </preface>




  <preface xml:id="math-141">
    <title>Math 141</title>


    <p>
      This 15-exercise sequence reviews quantitative reasoning, algebra, and
      function skills useful at the start of Math 141. The exercises are grouped
      in the requested order, and each can be randomized for additional practice.
    </p>


    <p><em>Percentages and proportions</em></p>


    <exercise xml:id="math141-percent-application">
      <title>Find a percentage of a quantity</title>
      <webwork source="Contrib/PCC/BasicMath/Percent/MTH20PercentApplicationType1_10.pg"/>
    </exercise>
    <exercise xml:id="math141-proportion-numerator">
      <title>Solve a proportion for an unknown numerator</title>
      <webwork source="Contrib/CCCS/QuantitativeLiteracy/Ratios_and_Conversions/Proportions_1.pg"/>
    </exercise>
    <exercise xml:id="math141-proportion-denominator">
      <title>Solve a proportion for an unknown denominator</title>
      <webwork source="Contrib/CCCS/QuantitativeLiteracy/Ratios_and_Conversions/Proportions_2.pg"/>
    </exercise>


    <p><em>Tables and graphs</em></p>


    <exercise xml:id="math141-percent-table">
      <title>Complete a percent, fraction, and decimal table</title>
      <webwork source="Contrib/CCCS/QuantitativeLiteracy/Percents/Convert_Percents_Table_1.pg"/>
    </exercise>
    <exercise xml:id="math141-mean-median">
      <title>Find the mean and median</title>
      <webwork source="Contrib/PCC/BasicMath/MeanMedianMode/MeanMedianMode120.pg"/>
    </exercise>


    <p><em>Fractions</em></p>


    <exercise xml:id="math141-add-fractions">
      <title>Add and reduce fractions</title>
      <webwork source="Library/ma112DB/set1_2/add_fractions.pg"/>
    </exercise>
    <exercise xml:id="math141-fraction-expressions">
      <title>Evaluate expressions with fractional inputs</title>
      <webwork source="Library/NewHampshire/unh_schoolib/Fractions/frabrs302.pg"/>
    </exercise>


    <p><em>Lines in the plane</em></p>


    <exercise xml:id="math141-slope-intercept">
      <title>Find slope and the vertical intercept</title>
      <webwork source="Library/PCC/BasicAlgebra/SlopeAndY-InterceptCalculations/FindSlopeYIntercept110.pg"/>
    </exercise>
    <exercise xml:id="math141-match-lines">
      <title>Match line equations with their graphs</title>
      <webwork source="Contrib/Fitchburg/Algebra/lines/choice-of-lines.pg"/>
    </exercise>
    <exercise xml:id="math141-linear-profit">
      <title>Interpret a linear profit model</title>
      <webwork source="Library/NewHampshire/NECAP/grade8/gr8-2005/n8-2005-7s.pg"/>
    </exercise>


    <p><em>Functions</em></p>


    <exercise xml:id="math141-cost-function">
      <title>Interpret a cost function</title>
      <webwork source="Contrib/CCCS/AlgebraicLiteracy/IA_3.5/OpenStax_IA_3.5_331.pg"/>
    </exercise>
    <exercise xml:id="math141-function-inputs">
      <title>Evaluate a function at numeric and symbolic inputs</title>
      <webwork source="Contrib/CCCS/AlgebraicLiteracy/IA_3.5/OpenStax_IA_3.5_Functions1.pg"/>
    </exercise>
    <exercise xml:id="math141-quadratic-function">
      <title>Evaluate a quadratic function</title>
      <webwork source="Contrib/CCCS/AlgebraicLiteracy/IA_3.5/OpenStax_IA_3.5_Functions2.pg"/>
    </exercise>


    <p><em>Modeling</em></p>


    <exercise xml:id="math141-context-model">
      <title>Interpret a function in context</title>
      <webwork source="Contrib/CUNY/CityTech/Precalculus/setIntroductiontoFunctions/FunctionInContext10.pg"/>
    </exercise>


    <p><em>Polynomial functions</em></p>


    <exercise xml:id="math141-polynomial-expression">
      <title>Expand and simplify a polynomial expression</title>
      <webwork source="Library/FortLewis/Algebra/4-2-Functions-and-expressions/MCH1-4-2-14-Functions-and-expressions.pg"/>
    </exercise>
  </preface>


