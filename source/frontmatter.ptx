  <preface xml:id="math-111">
    <title>Math 111</title>

    <p>
      This 16-exercise sequence reviews the algebra and trigonometry skills most
      useful when beginning calculus. Open an exercise to begin, and use
      <q>Randomize</q> after checking a response to practice the same idea with
      new values.
    </p>

    <paragraphs xml:id="math111-working-with-functions">
      <title>Working with Functions</title>

      <p><em>Evaluating and Interpreting Functions</em></p>

      <exercise xml:id="math111-functions-11">
        <title>Evaluate a Function at Given Inputs</title>
        <webwork source="Contrib/CCCS/AlgebraicLiteracy/IA_3.5/OpenStax_IA_3.5_Functions1.pg"/>
      </exercise>
      <exercise xml:id="math111-functions-20">
        <title>Evaluate a Piecewise-Defined Function</title>
        <webwork source="Contrib/CCCS/CollegeAlgebra/3.2/RRCC_CCCS_Openstax_AlgTrig_AT-1-001-AS_3_2_49.pg"/>
      </exercise>

      <p><em>Composing Functions</em></p>

      <exercise xml:id="math111-composition-1">
        <title>Compose Two Functions</title>
        <webwork source="Contrib/CCCS/CollegeAlgebra/3.4/RRCC_CCCS_Openstax_AlgTrig_AT-1-001-AS_3_4_11.pg"/>
      </exercise>
    </paragraphs>

    <paragraphs xml:id="math111-linear-equations">
      <title>Linear Equations</title>

      <p><em>Equations and Graphs of Lines</em></p>

      <exercise xml:id="math111-lines-1">
        <title>Find a Line Through Two Points</title>
        <webwork source="Contrib/CCCS/AlgebraicLiteracy/Equations_of_Lines/Equation_of_Lines_2.pg"/>
      </exercise>
      <exercise xml:id="math111-lines-2">
        <title>Write a Line from Its Slope and a Point</title>
        <webwork source="Contrib/Fitchburg/Algebra/lines/line-1.pg"/>
      </exercise>
      <exercise xml:id="math111-lines-4">
        <title>Read and Model a Line from Its Graph</title>
        <webwork source="Contrib/CUNY/CityTech/CollegeAlgebra_Trig/setLinesReview/from-graph-ratl-inter.pg"/>
      </exercise>
    </paragraphs>

    <paragraphs xml:id="math111-polynomial-rational-expressions">
      <title>Polynomial and Rational Expressions</title>

      <p><em>Simplifying Polynomials</em></p>

      <exercise xml:id="math111-polynomials-5">
        <title>Expand and Simplify a Polynomial Expression</title>
        <webwork source="Library/FortLewis/Algebra/4-2-Functions-and-expressions/MCH1-4-2-14-Functions-and-expressions.pg"/>
      </exercise>

      <p><em>Factoring Polynomials</em></p>

      <exercise xml:id="math111-factoring-12">
        <title>Factor a Quadratic Polynomial</title>
        <webwork source="Contrib/CCCS/CollegeAlgebra/Prerequisite_Review/CCD_CCCS_Openstax_AlgTrig_AT-1-001-AS_1_5_F.pg"/>
      </exercise>

      <p><em>Zeros and Intercepts</em></p>

      <exercise xml:id="math111-roots-1">
        <title>Find the Intercepts of a Polynomial</title>
        <webwork source="Contrib/CCCS/CollegeAlgebra/5.2/RRCC_CCCS_Openstax_AlgTrig_AT-1-001-AS_5_2_25.pg"/>
      </exercise>

      <p><em>Rational Equations and Functions</em></p>

      <exercise xml:id="math111-rational-4">
        <title>Solve a Rational Equation</title>
        <webwork source="Contrib/CCCS/AlgebraicLiteracy/IA_7.4/CCD_CCCS_Openstax_IntAlg_IA-2017-000-LC_7_4_203.pg"/>
      </exercise>
      <exercise xml:id="math111-rational-15">
        <title>Find a Removable Discontinuity</title>
        <webwork source="Contrib/CCCS/CollegeAlgebra/5.6/RRCC_CCCS_Openstax_AlgTrig_AT-1-001-AS_5_6_75.pg"/>
      </exercise>
    </paragraphs>

    <paragraphs xml:id="math111-exponents-logarithms">
      <title>Exponents and Logarithms</title>

      <p><em>Exponent Rules</em></p>

      <exercise xml:id="math111-exponents-1">
        <title>Apply the Power and Product Rules</title>
        <webwork source="Contrib/Mizzou/Algebra/exponents_integers/exp_ints_02.pg"/>
      </exercise>
      <exercise xml:id="math111-exponents-10">
        <title>Simplify an Exponential Expression</title>
        <webwork source="Contrib/Mizzou/Algebra/exponents_integers/exp_ints_14.pg"/>
      </exercise>

      <p><em>Logarithm Basics</em></p>

      <exercise xml:id="math111-logarithms-4">
        <title>Evaluate Basic Logarithms</title>
        <webwork source="Contrib/CCCS/CollegeAlgebra/6.3/RRCC_CCCS_Openstax_AlgTrig_AT-1-001-AS_6_3_51.pg"/>
      </exercise>
    </paragraphs>

    <paragraphs xml:id="math111-trigonometry">
      <title>Trigonometry</title>

      <p><em>Exact Values and Right Triangles</em></p>

      <exercise xml:id="math111-trig-1">
        <title>Find Exact Cosine Values on the Unit Circle</title>
        <webwork source="Contrib/CUNY/CityTech/CollegeAlgebra_Trig/UnitCircle/unit-circle-cosine.pg"/>
      </exercise>
      <exercise xml:id="math111-trig-7">
        <title>Solve a Right Triangle</title>
        <webwork source="Library/Rochester/setTrig03FunctionsRightAngle/p8.pg"/>
      </exercise>
    </paragraphs>
  </preface>




  <preface xml:id="stat-141">
    <title>Stat 141</title>

    <p>
      This 15-exercise sequence reviews the numerical, algebraic, and function
      skills most useful when beginning statistics. Open an exercise to begin,
      and use <q>Randomize</q> after checking a response to practice the same
      idea with new values.
    </p>

    <paragraphs xml:id="stat141-quantitative-reasoning">
      <title>Quantitative Reasoning</title>

      <p><em>Percentages and Proportions</em></p>

      <exercise xml:id="stat141-percent-application">
        <title>Calculate a Percentage of a Quantity</title>
        <webwork source="Contrib/PCC/BasicMath/Percent/MTH20PercentApplicationType1_10.pg"/>
      </exercise>
      <exercise xml:id="stat141-proportion-numerator">
        <title>Solve a Proportion with an Unknown Numerator</title>
        <webwork source="Contrib/CCCS/QuantitativeLiteracy/Ratios_and_Conversions/Proportions_1.pg"/>
      </exercise>
      <exercise xml:id="stat141-proportion-denominator">
        <title>Solve a Proportion with an Unknown Denominator</title>
        <webwork source="Contrib/CCCS/QuantitativeLiteracy/Ratios_and_Conversions/Proportions_2.pg"/>
      </exercise>

      <p><em>Tables and Summary Statistics</em></p>

      <exercise xml:id="stat141-percent-table">
        <title>Convert Among Percents, Fractions, and Decimals</title>
        <webwork source="Contrib/CCCS/QuantitativeLiteracy/Percents/Convert_Percents_Table_1.pg"/>
      </exercise>
      <exercise xml:id="stat141-mean-median">
        <title>Calculate the Mean and Median</title>
        <webwork source="Contrib/PCC/BasicMath/MeanMedianMode/MeanMedianMode120.pg"/>
      </exercise>
    </paragraphs>

    <paragraphs xml:id="stat141-algebraic-foundations">
      <title>Algebraic Foundations</title>

      <p><em>Fractions and Fractional Expressions</em></p>

      <exercise xml:id="stat141-add-fractions">
        <title>Add and Simplify Fractions</title>
        <webwork source="Library/ma112DB/set1_2/add_fractions.pg"/>
      </exercise>
      <exercise xml:id="stat141-fraction-expressions">
        <title>Evaluate Expressions with Fractional Inputs</title>
        <webwork source="Library/NewHampshire/unh_schoolib/Fractions/frabrs302.pg"/>
      </exercise>

      <p><em>Linear Equations and Graphs</em></p>

      <exercise xml:id="stat141-slope-intercept">
        <title>Find a Line's Slope and Vertical Intercept</title>
        <webwork source="Library/PCC/BasicAlgebra/SlopeAndY-InterceptCalculations/FindSlopeYIntercept110.pg"/>
      </exercise>
      <exercise xml:id="stat141-match-lines">
        <title>Match Linear Equations to Their Graphs</title>
        <webwork source="Contrib/Fitchburg/Algebra/lines/choice-of-lines.pg"/>
      </exercise>
      <exercise xml:id="stat141-linear-profit">
        <title>Interpret a Linear Profit Model</title>
        <webwork source="Library/NewHampshire/NECAP/grade8/gr8-2005/n8-2005-7s.pg"/>
      </exercise>
    </paragraphs>

    <paragraphs xml:id="stat141-functions-modeling">
      <title>Functions and Modeling</title>

      <p><em>Evaluating and Interpreting Functions</em></p>

      <exercise xml:id="stat141-cost-function">
        <title>Interpret a Cost Function</title>
        <webwork source="Contrib/CCCS/AlgebraicLiteracy/IA_3.5/OpenStax_IA_3.5_331.pg"/>
      </exercise>
      <exercise xml:id="stat141-function-inputs">
        <title>Evaluate a Function at Numeric and Symbolic Inputs</title>
        <webwork source="Contrib/CCCS/AlgebraicLiteracy/IA_3.5/OpenStax_IA_3.5_Functions1.pg"/>
      </exercise>
      <exercise xml:id="stat141-quadratic-function">
        <title>Evaluate a Quadratic Function</title>
        <webwork source="Contrib/CCCS/AlgebraicLiteracy/IA_3.5/OpenStax_IA_3.5_Functions2.pg"/>
      </exercise>

      <p><em>Modeling in Context</em></p>

      <exercise xml:id="stat141-context-model">
        <title>Interpret a Function in Context</title>
        <webwork source="Contrib/CUNY/CityTech/Precalculus/setIntroductiontoFunctions/FunctionInContext10.pg"/>
      </exercise>
    </paragraphs>

    <paragraphs xml:id="stat141-polynomial-expressions">
      <title>Polynomial Expressions</title>

      <p><em>Simplifying Polynomials</em></p>

      <exercise xml:id="stat141-polynomial-expression">
        <title>Expand and Simplify a Polynomial Expression</title>
        <webwork source="Library/FortLewis/Algebra/4-2-Functions-and-expressions/MCH1-4-2-14-Functions-and-expressions.pg"/>
      </exercise>
    </paragraphs>
  </preface>


